        },
        "url": {
          "raw": "{{keycloak_url}}/realms/books-realm/protocol/openid-connect/token",
          "host": [
            "{{keycloak_url}}"
          ],
          "path": [
            "realms",
            "books-realm",
            "protocol",
            "openid-connect",
            "token"
          ]
        },
        "description": "Refresh the JWT token using refresh_token"
